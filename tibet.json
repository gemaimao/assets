      },
      "paint": {
        "line-color": "#0d9488",
        "line-width": 4
      }
    },
    {
      "id": "niyang-points-layer",
      "type": "circle",
      "source": {
        "type": "geojson",
        "data": "./niyang_river.geojson"
      },
      "paint": {
        "circle-color": "#e11d48",
        "circle-radius": 8,
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    }
  ],
  "styles": {},
  "preferences": {
    "map": {
      "restrictBounds": false,
      "bounds": [
        -180,
        -85,
        180,
        85
      ],
      "minZoom": 0,
      "maxZoom": 24,
      "maxPitch": 85,
      "renderWorldCopies": true
    },
    "environmentVariables": []
  },
  "plugins": {
    "activePluginIds": [
      "maplibre-layer-control",
      "maplibre-gl-geoagent"
    ],
    "mapControlPositions": {
      "maplibre-layer-control": "top-right",
      "maplibre-gl-basemap-control": "top-left",
      "maplibre-gl-esri-wayback": "top-left",
      "maplibre-gl-geoagent": "top-left",
      "maplibre-gl-geo-editor": "top-left",
      "maplibre-gl-lidar": "top-left",
      "maplibre-gl-streetview": "top-right",
      "maplibre-gl-swipe": "top-left",
      "maplibre-gl-components": "top-right"
    },
    "settings": {}
  },
  "metadata": {
    "author": "Longhulin",
    "description": "尼洋河河口则拉岗的历史地理解析"
