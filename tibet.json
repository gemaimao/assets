{
  "version": "0.1.0",
  "name": "西藏尼洋河历史地理解析 (Tibet Map Project)",
  "mapView": {
    "center": [
      92.23906518508079,
      29.08738320612193
    ],
    "zoom": 11.2,
    "bearing": 0,
    "pitch": 0,
    "bbox": [
      92.10238978054736,
      28.98650869426101,
      92.37574058961286,
      29.188147227793397
    ]
  },
  "basemapStyleUrl": "https://tiles.openfreemap.org/styles/liberty",
  "basemapVisible": true,
  "basemapOpacity": 1,
  "layers": [
    {
      "id": "niyang-river-layer",
